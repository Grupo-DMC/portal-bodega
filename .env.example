# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genere uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Contraseña de los usuarios DEMO (solo mientras se usan datos ficticios).
# Si no se define, se usa "dmc2026". NUNCA usar en producción.
DEMO_PASSWORD=
# Muestra los accesos rápidos de usuarios demo en el login (solo desarrollo).
NEXT_PUBLIC_SHOW_DEMO_USERS=1

# ── SQL Server (cuando se reemplacen los datos ficticios) ──
MSSQL_SERVER=
MSSQL_DATABASE=DMC_Bodega
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
